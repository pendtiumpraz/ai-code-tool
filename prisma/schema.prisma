// Prisma Schema for AI Code Studio
// PostgreSQL Database with Complete User Isolation

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // directUrl = env("DIRECT_URL") // Uncomment for Vercel Postgres connection pooling
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum PlanType {
  FREE
  STARTER
  PRO
  BUSINESS
  ENTERPRISE
  CUSTOM
}

// ============================================
// USER & AUTHENTICATION
// ============================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  role          UserRole  @default(USER)
  
  // Google Drive Integration (encrypted tokens)
  googleAccessToken   String?  @db.Text
  googleRefreshToken  String?  @db.Text
  googleTokenExpiry   DateTime?
  googleDriveFolderId String?  // User's isolated root folder in Google Drive
  
  // Daily/Monthly Usage Counters
  dailyTokensUsed     Int      @default(0)
  dailyToolCalls      Int      @default(0)
  dailyRequests       Int      @default(0)
  monthlyTokensUsed   Int      @default(0)
  monthlyStorageMB    Float    @default(0)
  lastDailyReset      DateTime @default(now())
  lastMonthlyReset    DateTime @default(now())
  
  // OAuth & Sessions
  accounts      Account[]
  sessions      Session[]
  
  // User Data (ALL ISOLATED - no cross-user access)
  subscription    Subscription?
  projects        Project[]
  files           UserFile[]
  tasks           Task[]
  chatHistory     ChatHistory[]
  apiKeys         ApiKey[]
  usageLogs       UsageLog[]
  securityKeys    UserSecurityKeys?
  
  // Admin: License Management
  createdLicenses  License[]  @relation("LicenseCreator")
  assignedLicense  License?   @relation("LicenseUser")
  
  // Settings
  settings      Json      @default("{}")
  timezone      String    @default("UTC")
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([email])
  @@index([role])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================
// SUBSCRIPTION & PLANS
// ============================================

model Plan {
  id              String   @id @default(cuid())
  name            String   @unique  // free, starter, pro, business, enterprise
  displayName     String
  type            PlanType
  
  // Pricing
  priceMonthly    Float    @default(0)
  priceYearly     Float    @default(0)
  currency        String   @default("USD")
  
  // Limits
  tokensPerDay        Int      @default(10000)    // AI tokens per day
  tokensPerMonth      Int      @default(300000)   // AI tokens per month
  toolCallsPerDay     Int      @default(50)       // Tool/API calls per day
  requestsPerDay      Int      @default(100)      // Total requests per day
  requestsPerMinute   Int      @default(10)       // Rate limit
  storageMB           Int      @default(100)      // Google Drive storage allocation
  projectsLimit       Int      @default(3)        // Max projects
  teamMembers         Int      @default(1)        // Team seats
  
  // Features (JSON array of feature keys)
  features        String[]
  
  // UI
  highlighted     Boolean  @default(false)  // Featured plan
  sortOrder       Int      @default(0)
  
  isActive        Boolean  @default(true)
  
  subscriptions   Subscription[]
  licenses        License[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("plans")
}

model Subscription {
  id              String             @id @default(cuid())
  userId          String             @unique
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId          String
  plan            Plan               @relation(fields: [planId], references: [id])
  
  status          SubscriptionStatus @default(TRIAL)
  
  // Trial
  trialEndsAt     DateTime?
  
  // Billing Cycle
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  
  // Payment (Stripe, etc.)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  
  // Custom Limits (override plan defaults)
  customTokensPerDay   Int?
  customTokensPerMonth Int?
  customStorageMB      Int?
  
  canceledAt      DateTime?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@map("subscriptions")
}

// Admin-created licenses (for enterprise, custom deals)
model License {
  id              String   @id @default(cuid())
  code            String   @unique  // License key
  
  // Plan
  planId          String
  plan            Plan     @relation(fields: [planId], references: [id])
  
  // Creator (Admin)
  createdById     String
  createdBy       User     @relation("LicenseCreator", fields: [createdById], references: [id])
  
  // Assigned User
  assignedToId    String?  @unique
  assignedTo      User?    @relation("LicenseUser", fields: [assignedToId], references: [id])
  
  // Validity
  validFrom       DateTime @default(now())
  validUntil      DateTime?
  maxActivations  Int      @default(1)
  activationCount Int      @default(0)
  
  // Custom limits
  customTokensPerMonth Int?
  customStorageMB      Int?
  
  // Notes
  notes           String?  @db.Text
  
  isActive        Boolean  @default(true)
  
  activatedAt     DateTime?
  createdAt       DateTime @default(now())

  @@index([code])
  @@index([createdById])
  @@map("licenses")
}

// ============================================
// USER FILES (Google Drive Integration)
// ============================================

model UserFile {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId     String?
  project       Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  
  // File Info
  name          String
  path          String      // Virtual path within user's space
  mimeType      String?
  size          Int         @default(0)  // bytes
  
  // Google Drive Reference
  googleDriveId String?     // Google Drive file ID
  googleDriveUrl String?    // Direct link
  
  // For caching small files
  content       String?     @db.Text
  
  // Metadata
  isFolder      Boolean     @default(false)
  parentId      String?     // Parent folder ID
  
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([userId, path])
  @@index([userId])
  @@index([projectId])
  @@index([googleDriveId])
  @@map("user_files")
}

// ============================================
// PROJECTS (Isolated per User)
// ============================================

model Project {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  name        String
  description String?
  workspace   String   // Workspace type
  
  // Google Drive folder for this project
  googleDriveFolderId String?
  
  // Settings
  settings    Json     @default("{}")
  
  // Relations
  files       UserFile[]
  tasks       Task[]
  chatHistory ChatHistory[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([workspace])
  @@map("projects")
}

// ============================================
// CHAT HISTORY (Isolated per User)
// ============================================

model ChatHistory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  
  // Chat Data
  title     String?
  messages  Json     // Array of messages
  model     String   // AI model used
  
  // Usage
  tokensUsed Int     @default(0)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([projectId])
  @@map("chat_history")
}

// ============================================
// TASKS (Agentic Tasks - Isolated per User)
// ============================================

model Task {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  
  title       String
  description String?  @db.Text
  type        String
  workspace   String
  
  // Status
  status      String   @default("draft")
  progress    Float    @default(0)
  
  // Context & Output
  context     Json     @default("{}")
  output      Json     @default("{}")
  
  // Execution
  startedAt   DateTime?
  completedAt DateTime?
  error       String?  @db.Text
  
  toolCalls   ToolCall[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([projectId])
  @@index([status])
  @@map("tasks")
}

model ToolCall {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  
  toolName  String
  arguments Json
  result    Json?
  status    String   @default("pending")
  error     String?
  duration  Int?
  
  createdAt DateTime @default(now())

  @@index([taskId])
  @@map("tool_calls")
}

// ============================================
// API KEYS (Isolated per User)
// ============================================

model ApiKey {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  name       String
  key        String   @unique  // Hashed
  prefix     String            // First 8 chars
  
  scopes     String[]
  rateLimit  Int?
  
  lastUsed   DateTime?
  usageCount Int      @default(0)
  expiresAt  DateTime?
  
  createdAt  DateTime @default(now())

  @@index([userId])
  @@map("api_keys")
}

// ============================================
// USAGE LOGS (Detailed tracking per User)
// ============================================

model UsageLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  type      String   // ai_tokens, tool_call, storage, request
  amount    Int      // Usage amount
  
  // Details
  model     String?  // AI model
  endpoint  String?  // API endpoint
  workspace String?  // Workspace used
  
  metadata  Json?
  
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@map("usage_logs")
}

// ============================================
// TEMPLATES (Public & Private)
// ============================================

model Template {
  id          String   @id @default(cuid())
  
  name        String
  description String?
  workspace   String
  type        String
  
  content     Json
  
  isPublic    Boolean  @default(false)
  createdBy   String?
  
  usageCount  Int      @default(0)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([workspace])
  @@index([isPublic])
  @@map("templates")
}

// ============================================
// USER SECURITY API KEYS (External Services)
// ============================================

model UserSecurityKeys {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Encrypted API Keys (use encryption in application layer)
  shodanKey       String?  @db.Text  // Shodan API key
  virusTotalKey   String?  @db.Text  // VirusTotal API key
  
  // Future: Add more service keys as needed
  // securityTrailsKey String?
  // censysKey         String?
  // abuseIpDbKey      String?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_security_keys")
}

// ============================================
// ADMIN: AUDIT LOGS
// ============================================

model AuditLog {
  id        String   @id @default(cuid())
  
  userId    String?  // User who performed action
  adminId   String?  // Admin who performed action (if admin action)
  
  action    String   // create_license, update_user, delete_project, etc.
  resource  String   // user, license, project, etc.
  resourceId String?
  
  details   Json?    // Additional details
  ipAddress String?
  userAgent String?
  
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([adminId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
