# ============================================
# AI CODE STUDIO - Environment Variables
# ============================================

# Database (Vercel Postgres)
DATABASE_URL="postgresql://username:password@host:5432/database?sslmode=require"
DIRECT_URL="postgresql://username:password@host:5432/database?sslmode=require"

# NextAuth
NEXTAUTH_SECRET="your-super-secret-key-here-generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (dengan Google Drive scope)
# Buat di: https://console.cloud.google.com/apis/credentials
# Scopes yang dibutuhkan:
# - openid
# - email  
# - profile
# - https://www.googleapis.com/auth/drive.file
# - https://www.googleapis.com/auth/drive.appdata
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ============================================
# GOOGLE AI (Gemini) - FREE!
# Get API key: https://aistudio.google.com/app/apikey
# ============================================
GOOGLE_AI_API_KEY="your-google-ai-api-key"

# Models (auto-fallback):
# - gemini-2.0-flash-exp   (Powerful + Code Execution) - 10 RPM
# - gemini-2.0-flash       (Balanced + Tool Calling)   - 15 RPM  
# - gemini-2.0-flash-lite  (Fast, simple chat)         - 30 RPM
#
# System will auto-fallback if rate limited!

# ============================================
# Optional: Stripe (untuk pembayaran)
# ============================================
# STRIPE_SECRET_KEY="sk_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_..."

# ============================================
# Optional: Email (untuk notifikasi)
# ============================================
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER="your-email@example.com"
# SMTP_PASSWORD="your-password"
# EMAIL_FROM="AI Code Studio <noreply@example.com>"
